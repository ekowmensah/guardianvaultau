# Required in production. Configure these in Apache/PHP-FPM or the host's secret manager.
# On shared cPanel hosting, copy config.example.php to config.php instead.
GUARDIAN_APP_ENV=production
GUARDIAN_DB_HOST=127.0.0.1
GUARDIAN_DB_PORT=3306
GUARDIAN_DB_NAME=guardianvaultau
GUARDIAN_DB_USER=guardian_app
GUARDIAN_DB_PASSWORD=replace-with-a-long-random-password
GUARDIAN_APP_KEY=replace-with-at-least-32-random-bytes
GUARDIAN_SESSION_IDLE_MINUTES=30
GUARDIAN_SESSION_ABSOLUTE_HOURS=12
GUARDIAN_TIMEZONE=Australia/Sydney
GUARDIAN_ADMIN_MFA_REQUIRED=0
# Set to 1 only when requests pass through a trusted reverse proxy that sets X-Forwarded-Proto.
GUARDIAN_TRUST_PROXY=0
