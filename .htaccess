Options -Indexes
DirectoryIndex index.php login.php index.html
ServerSignature Off

<FilesMatch "(^\.|error_log|.*\.(sql|bak|old|dist|log|ini|zip)$)">
    Require all denied
</FilesMatch>

<FilesMatch "^(app_security|app_config|config|config\.example|db_conn|user_header|user_footer)\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header onsuccess unset X-Content-Type-Options
    Header onsuccess unset X-Frame-Options
    Header onsuccess unset Referrer-Policy
    Header onsuccess unset Content-Security-Policy
    Header onsuccess unset Permissions-Policy
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>
